{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "buildCommand": "cd apps/web && npx prisma migrate deploy && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "apps/web/.next",
  "framework": "nextjs",

  "regions": ["fra1"],

  "headers": [
    {
      "source": "/api/og(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=900, stale-while-revalidate=3600" }
      ]
    }
  ],

"crons": [
    { "path": "/api/auction/cron",                  "schedule": "* * * * *"    },
    { "path": "/api/cron/market-candles",           "schedule": "* * * * *"    },
    { "path": "/api/cron/lot-phase-auto-start",     "schedule": "*/5 * * * *"  },
    { "path": "/api/cron/circuit-breaker-check",    "schedule": "*/5 * * * *"  },
    { "path": "/api/cron/ohlc-eod-close",           "schedule": "5 0 * * *"    },
    { "path": "/api/cron/kyc-deadline-check",       "schedule": "30 7 * * *"   },
    { "path": "/api/cron/risk-rescore",             "schedule": "0 2 * * *"    }
  ],

"git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
