# ─── EUCX Web — Pflicht-Umgebungsvariablen ────────────────────────────────────
# Kopieren als .env.local für lokale Entwicklung.
# In Production: Vercel Dashboard → Settings → Environment Variables

# ── Datenbank ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/eucx?pgbouncer=true&connection_limit=10&pool_timeout=15&sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/eucx"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="dev-secret-CHANGE-IN-PRODUCTION-min-32-chars-required"
REFRESH_JWT_SECRET="dev-refresh-secret-CHANGE-IN-PRODUCTION-min-32-chars-required"

# ── Upstash Redis (Rate Limiting, Token-Blacklist) ────────────────────────────
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# ── E-Mail (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_DOMAIN_VERIFIED=false

# ── Cron-Sicherheit ───────────────────────────────────────────────────────────
CRON_SECRET="cron-secret-CHANGE-IN-PRODUCTION"

# ── QStash ────────────────────────────────────────────────────────────────────
QSTASH_TOKEN="eyJ..."
QSTASH_CURRENT_SIGNING_KEY="sig_xxx"

# ── Interne Service-URLs ──────────────────────────────────────────────────────
NESTJS_INTERNAL_URL="https://api.eucx.eu"

# ── Öffentliche URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://eucx.eu"
NEXT_PUBLIC_API_URL="https://api.eucx.eu"
NEXT_PUBLIC_WS_URL="wss://api.eucx.eu"

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@eucx.eu"

# ── Umsatzsteuer ─────────────────────────────────────────────────────────────
EUCX_VAT_ID="DE123456789"

# ── Bankverbindung ────────────────────────────────────────────────────────────
EUCX_BANK_IBAN=DE89370400440532013000
EUCX_BANK_BIC=COBADEFFXXX
