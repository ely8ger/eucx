# ─── EUCX Web — Pflicht-Umgebungsvariablen ────────────────────────────────────
# Kopieren als .env.local für lokale Entwicklung.
# In Production: Vercel Dashboard → Settings → Environment Variables

# ── Datenbank ─────────────────────────────────────────────────────────────────
# Für Vercel Serverless MUSS der Pooler-URL mit ?pgbouncer=true&connection_limit=1
# verwendet werden, um das PostgreSQL-Connection-Limit nicht zu erschöpfen.
# Neon-Beispiel:
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/eucx?pgbouncer=true&connection_limit=10&pool_timeout=15&sslmode=require"
# DIRECT_URL (ohne Pooler) — nur für Prisma-Migrationen (prisma migrate deploy)
DIRECT_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/eucx"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Beide Secrets müssen unterschiedlich sein und mindestens 32 Zeichen lang.
# Trennung verhindert, dass ein kompromittierter Access-Token als Refresh-Token missbraucht wird.
# In Production niemals die Dev-Werte verwenden.
JWT_SECRET="dev-secret-CHANGE-IN-PRODUCTION-min-32-chars-required"
REFRESH_JWT_SECRET="dev-refresh-secret-CHANGE-IN-PRODUCTION-min-32-chars-required"

# ── Upstash Redis (Rate Limiting, Realtime Event Bus, Token-Blacklist) ─────────
# In Production Pflicht. Ohne Redis: Auth-Rate-Limiting ist fail-closed (Fehler statt silent-allow).
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxx..."

# Lokale Entwicklung ohne Redis (In-Memory-Fallback, kein Upstash nötig):
# ENABLE_MEMORY_RATE_LIMIT=true

# ── E-Mail (Resend) ───────────────────────────────────────────────────────────
# In Production Pflicht (Passwort-Reset, Verifizierungs-Mails).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auf "true" setzen sobald eucx.eu in Resend verifiziert ist
RESEND_DOMAIN_VERIFIED=false

# ── Cron-Sicherheit ───────────────────────────────────────────────────────────
# In Production Pflicht. Vercel setzt diesen Header automatisch für Cron-Jobs.
# Wert beliebig, mindestens 32 Zeichen empfohlen.
CRON_SECRET="cron-secret-CHANGE-IN-PRODUCTION"

# ── QStash (Vercel Worker-Queue) ──────────────────────────────────────────────
QSTASH_TOKEN="eyJ..."
QSTASH_CURRENT_SIGNING_KEY="sig_xxx"

# ── Interne Service-URLs ──────────────────────────────────────────────────────
# NestJS-API (für interne Server-zu-Server-Kommunikation)
NESTJS_INTERNAL_URL="https://api.eucx.eu"

# ── Öffentliche URLs ──────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://eucx.eu"
NEXT_PUBLIC_API_URL="https://api.eucx.eu"
NEXT_PUBLIC_WS_URL="wss://api.eucx.eu"

# ── Bankverbindung (Wallet-Aufladung) ─────────────────────────────────────────
EUCX_BANK_IBAN=DE89370400440532013000
EUCX_BANK_BIC=COBADEFFXXX

# ── Sonstiges ─────────────────────────────────────────────────────────────────
EUCX_VAT_ID="DE123456789"

# ── Compliance / Sanctions ───────────────────────────────────────────────────
# OpenSanctions API für Compliance-Screening.
# Konto: https://www.opensanctions.org/api/ — kostenloser Tier verfügbar.
OPENSANCTIONS_API_KEY="os-xxxxxxxxxxxxxxxxxxxx"

# ── Settlement Feature-Flag ───────────────────────────────────────────────────
# Auf "true" setzen um automatisches Settlement zu aktivieren.
# In Production erst aktivieren wenn Settlement-Bridge vollständig geprüft ist.
EUCX_SETTLEMENT_ENABLED="false"

# ── Sentry (Error Monitoring) ─────────────────────────────────────────────────
# Sentry DSN: https://sentry.io → Projekt erstellen → Settings → SDK Setup
# SENTRY_DSN: Server-seitig (nicht im Browser-Bundle)
SENTRY_DSN="https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX"
# NEXT_PUBLIC_SENTRY_DSN: Client-seitig (Browser-Bundle)
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX"
# Für Source-Map-Upload bei Vercel-Deployment (Sentry → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxx"
SENTRY_ORG="eucx"
SENTRY_PROJECT="eucx-web"

# ── Cron Healthcheck (Dead-Man's-Switch) ──────────────────────────────────────
# URL wird nach jedem erfolgreichen Cron-Lauf gepingt.
# Dienste: healthchecks.io (kostenlos) oder BetterUptime.
# Bei Ausbleiben des Pings → Alarm → Benachrichtigung.
HEALTHCHECK_CRON_URL="https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
